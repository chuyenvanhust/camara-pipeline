COMPOSE_PROJECT_NAME=camara-pipeline

# ==============================================================================
# Cấu hình môi trường phát triển (Development)
# Sao chép .env.example để tạo cấu hình mới; dùng .env.production.example cho production.
# ==============================================================================

# --- KAFKA CLUSTER ---
KAFKA_BOOTSTRAP_SERVERS=camara-kafka:9092,camara-kafka-2:9092,camara-kafka-3:9092
KAFKA_TOPIC_RAW=radius.accounting.raw
KAFKA_TOPIC_PARTITIONS=16
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_CPUS=4

# --- POSTGRESQL ---
POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=camara
POSTGRES_LOCAL_DB=camara_db
DATABASE_URL=postgresql://postgres:camara@camara-postgres:5432/camara_db
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_WAL_SIZE=2GB
IP_MSISDN_DB_POOL_MIN=3
IP_MSISDN_DB_POOL_MAX=12
DEVICE_SWAP_DB_POOL_MIN=2
DEVICE_SWAP_DB_POOL_MAX=8
SIM_SWAP_DB_POOL_MIN=2
SIM_SWAP_DB_POOL_MAX=8
POSTGRES_MEM_LIMIT=3g
POSTGRES_CPUS=4

# --- REDIS ---
REDIS_HOST=camara-redis
REDIS_PORT=6379
REDIS_PASSWORD=camara_redis_dev_secret
REDIS_MAXMEMORY=512mb
REDIS_MEM_LIMIT=640m

# --- INGESTION ---
RADIUS_SHARED_SECRET=camara-radius-dev-secret
RADIUS_UDP_RECEIVE_BUFFER_BYTES=33554432
RADIUS_UDP_QUEUE_MAX_RECORDS=300000
RADIUS_UDP_KAFKA_BATCH_RECORDS=500
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=5
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=4
RADIUS_UDP_KAFKA_PRESSURE_INFLIGHT_BATCHES_PER_WORKER=6
RADIUS_UDP_KAFKA_PRESSURE_QUEUE_RATIO=0.5
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=24
RADIUS_UDP_PUBLISHER_WORKERS=4
RADIUS_UDP_KAFKA_PRODUCERS=4
INGESTION_BATCH_SIZE_BYTES=524288
INGESTION_LINGER_MS=5
INGESTION_COMPRESSION_TYPE=lz4
INGESTION_KAFKA_PERSIST_WARN_MS=500
INGESTION_QUEUE_WARN_MS=1000
RADIUS_INGESTION_MEM_LIMIT=1g
RADIUS_INGESTION_CPUS=2

# --- PIPELINE CONSUMERS ---
CONSUMERS_PER_GROUP=4
PROCESSING_PARTITION_CONCURRENCY=2
BATCH_MAX_RECORDS=4000
BATCH_TIMEOUT_MS=10
THROUGHPUT_LOG_INTERVAL_SECONDS=10
PIPELINE_IP_MEM_LIMIT=2g
PIPELINE_IP_CPUS=2
PIPELINE_DEVICE_MEM_LIMIT=2g
PIPELINE_DEVICE_CPUS=2
PIPELINE_SIM_MEM_LIMIT=2g
PIPELINE_SIM_CPUS=2

# --- DISPATCHER ---
DISPATCHER_BATCH_SIZE=50
DISPATCHER_POLL_INTERVAL=2.0
DISPATCHER_MAX_ATTEMPTS=5
WEBHOOK_SIGNING_SECRET=camara_webhook_hmac_secret_key

# --- SECURITY & API ---
ENVIRONMENT=development
API_KEY=dev-secret

# --- MONITORING ---
METRICS_PORT=9200
INGESTION_METRICS_PORT=9201
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
