<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Data Quality Report - CAMARA Pipeline</title>
    <script src="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans">

    <header class="bg-indigo-700 text-white p-6 shadow-md">
        <div class="container mx-auto flex justify-between items-center">
            <div>
                <h1 class="text-3xl font-bold tracking-tight">CAMARA Data Quality Report</h1>
                <p class="text-sm text-indigo-200 mt-1">Automated Pipeline Execution Analytics</p>
            </div>
            <div class="text-right text-sm">
                <p>Run Time: <span class="font-mono bg-indigo-800 px-2 py-1 rounded">{{ m.overview.timestamp }}</span></p>
            </div>
        </div>
    </header>

    {% if m._data_source == "mock_fallback" %}
    <div class="bg-red-600 text-white text-center py-3 font-bold">
        ⚠ CẢNH BÁO: Không kết nối được Postgres — toàn bộ số liệu bên dưới là DỮ LIỆU GIẢ (mock),
        KHÔNG phản ánh lần chạy pipeline thật. Lỗi: {{ m._data_source_error }}
    </div>
    {% endif %}

    <main class="container mx-auto px-4 py-8">

        <!-- Overview Cards -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-500">
                <h3 class="text-gray-500 text-xs font-medium uppercase">Total Processed Records</h3>
                <p class="text-3xl font-bold mt-2 text-gray-900">{{ "{:,}".format(m.overview.total_records) }}</p>
                <p class="text-xs text-gray-400 mt-1">RADIUS Accounting Logs</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-pink-500">
                <h3 class="text-gray-500 text-xs font-medium uppercase">SIM Swap Events</h3>
                <p class="text-3xl font-bold mt-2 text-pink-600">{{ "{:,}".format(m.overview.sim_swap_count) }}</p>
                <p class="text-xs text-gray-400 mt-1">Rate: {{ m.swaps.sim_swap_rate }}%</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-purple-500">
                <h3 class="text-gray-500 text-xs font-medium uppercase">Device Swap Events</h3>
                <p class="text-3xl font-bold mt-2 text-purple-600">{{ "{:,}".format(m.overview.device_swap_count) }}</p>
                <p class="text-xs text-gray-400 mt-1">Rate: {{ m.swaps.device_swap_rate }}%</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-500">
                <h3 class="text-gray-500 text-xs font-medium uppercase">Active Subscribers</h3>
                <p class="text-3xl font-bold mt-2 text-gray-900">{{ "{:,}".format(m.overview.subscribers_count) }}</p>
                <p class="text-xs text-gray-400 mt-1">Unique MSISDN Pool</p>
            </div>
        </section>

        <!-- Pipeline Throughput Metrics -->
        <section class="bg-white p-6 rounded-lg shadow mb-8">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Pipeline Throughput</h2>
            <!-- F-QR-FIX: 3 thẻ Producer/Consumer/DB-write trước đây hiển thị số
                 hard-code, không phản ánh đo lường thật (schema không lưu mốc thời
                 gian riêng từng giai đoạn) -> đã bỏ, chỉ giữ 1 số ĐO ĐƯỢC THẬT:
                 tổng event / khoảng thời gian giữa audit_log đầu-cuối. -->
            <div class="grid grid-cols-1 md:grid-cols-1 gap-6 max-w-sm">
                <div class="bg-purple-50 p-4 rounded border border-purple-100">
                    <span class="text-xs text-purple-600 font-semibold uppercase">Overall Pipeline Average (đo từ audit_log)</span>
                    <p class="text-2xl font-bold text-purple-900 mt-1">
                        {% if m.overview.overall_throughput is not none %}
                            {{ "{:,.1f}".format(m.overview.overall_throughput) }}
                        {% else %}
                            N/A (chưa đủ dữ liệu)
                        {% endif %}
                        <span class="text-sm font-normal text-purple-600">rec/s</span>
                    </p>
                    <p class="text-xs text-purple-400 mt-1">audit_log.created_at: first → last</p>
                </div>
            </div>
        </section>

        <!-- Pipeline Throughput Metrics (old block removed) -->
        <section class="hidden">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div class="bg-indigo-50 p-4 rounded border border-indigo-100">
                    <span class="text-xs text-indigo-600 font-semibold uppercase">1. Producer Ingestion Rate</span>
                    <p class="text-xs text-indigo-400 mt-1">CSV → Kafka `radius.raw`</p>
                </div>
                <div class="bg-blue-50 p-4 rounded border border-blue-100">
                    <span class="text-xs text-blue-600 font-semibold uppercase">2. Consumer Processing Rate</span>
                    <p class="text-xs text-blue-400 mt-1">Stream Evaluation & Parsing</p>
                </div>
                <div class="bg-green-50 p-4 rounded border border-green-100">
                    <span class="text-xs text-green-600 font-semibold uppercase">3. Postgres / Redis Write Rate</span>
                    <p class="text-xs text-green-400 mt-1">State & Audit Persistence</p>
                </div>
                <div class="bg-purple-50 p-4 rounded border border-purple-100">
                    <span class="text-xs text-purple-600 font-semibold uppercase">4. Overall Pipeline Average</span>
                    <p class="text-xs text-purple-400 mt-1">End-to-End Execution</p>
                </div>
            </div>
            </div>
        </section>

        <!-- Swap Events Distribution Analysis -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Swap Ratio Chart -->
            <div class="bg-white p-6 rounded-lg shadow lg:col-span-1">
                <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">Swap Event Ratio</h2>
                <div style="max-height: 250px;" class="flex justify-center">
                    <canvas id="swapRatioChart"></canvas>
                </div>
                <p class="text-sm text-gray-500 mt-4 text-center">
                    Total Detected Events: <strong>{{ "{:,}".format(m.swaps.total_swaps) }}</strong>
                </p>
            </div>

            <!-- Detailed Swap Table -->
            <div class="bg-white p-6 rounded-lg shadow lg:col-span-2">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Swap Events Summary</h2>
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200 text-sm">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left font-semibold text-gray-500 uppercase tracking-wider">Event Type</th>
                                <th class="px-6 py-3 text-right font-semibold text-gray-500 uppercase tracking-wider">Detected Count</th>
                                <th class="px-6 py-3 text-right font-semibold text-gray-500 uppercase tracking-wider">Occurrence Rate</th>
                                <th class="px-6 py-3 text-left font-semibold text-gray-500 uppercase tracking-wider">Metric Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 font-medium">
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-pink-600 font-bold">SIM Swap</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-mono">{{ "{:,}".format(m.swaps.sim_swap_count) }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-mono">{{ m.swaps.sim_swap_rate }}%</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-pink-100 text-pink-800">Target Config: 0.2%</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-purple-600 font-bold">Device Swap</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-mono">{{ "{:,}".format(m.swaps.device_swap_count) }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-mono">{{ m.swaps.device_swap_rate }}%</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-100 text-purple-800">Target Config: 0.2%</span>
                                </td>
                            </tr>
                            <tr class="bg-gray-50 font-bold">
                                <td class="px-6 py-4 whitespace-nowrap text-gray-700">Total Swaps</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-mono">{{ "{:,}".format(m.swaps.total_swaps) }}</td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-gray-900 font-mono">{{ m.swaps.overall_swap_rate }}%</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">Overall: {{ m.swaps.overall_swap_rate }}%</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Swap Ratio Chart (Comparing SIM Swap and Device Swap)
        new Chart(document.getElementById('swapRatioChart'), {
            type: 'doughnut',
            data: {
                labels: ['SIM Swap', 'Device Swap'],
                datasets: [{
                    data: [{{ m.swaps.sim_swap_count }}, {{ m.swaps.device_swap_count }}],
                    backgroundColor: ['#EC4899', '#8B5CF6']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom',
                    }
                }
            }
        });
    </script>
</body>
</html>