# --- KAFKA CONFIG ---
KAFKA_BOOTSTRAP_SERVERS=camara-kafka:9092
KAFKA_TOPIC_RAW=radius.raw
KAFKA_TOPIC_CLEAN=radius.clean
KAFKA_TOPIC_INVALID=radius.invalid
INGESTION_BATCH_SIZE=500
INGESTION_LINGER_MS=10

# --- DATABASE CONFIG ---
# Chú ý: DB_HOST phải trùng với container_name của postgres trong docker-compose
DB_HOST=camara-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=camara
DB_NAME=camara_db


# --- MOCK SERVICES URL (QUAN TRỌNG ĐỂ HẾT TREO) ---
# Dùng tên container và port nội bộ 8100
GSMA_TAC_API_URL=http://camara-mock-gsma-tac:8100
HLR_HSS_API_URL=http://camara-mock-hlr-hss:8100
ITU_E164_API_URL=http://camara-mock-itu-mock:8100

# --- SPARK CHECKPOINT CONFIG ---
PROCESSING_CHECKPOINT_DIR=/tmp/spark-pipeline-processing-checkpoint
STORAGE_CHECKPOINT_DIR=/tmp/spark-pipeline-storage-checkpoint
