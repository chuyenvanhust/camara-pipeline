# ==============================================================================
# CAMARA Data Pipeline — Staging Environment Configuration (.env.staging.example)
# Phù hợp cho máy chủ Staging / Load-Test (8 vCPU, 16GB RAM). Tải 10.000 - 15.000 pkt/s.
# ==============================================================================

ENVIRONMENT=staging

# --- KAFKA & ZOOKEEPER ---
KAFKA_BOOTSTRAP_SERVERS=camara-kafka:9092,camara-kafka-2:9092,camara-kafka-3:9092
KAFKA_TOPIC_RAW=radius.accounting.raw
KAFKA_TOPIC_PARTITIONS=16
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
ZOOKEEPER_MEM_LIMIT=256m
KAFKA_MEM_LIMIT=3g
KAFKA_CPUS=2

# --- POSTGRESQL ENGINE ---
POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=camara_staging_secure_password
POSTGRES_LOCAL_DB=camara_db
DATABASE_URL=postgresql://postgres:camara_staging_secure_password@camara-postgres:5432/camara_db
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_WAL_SIZE=2GB
PIPELINE_DB_POOL_MIN=6
PIPELINE_DB_POOL_MAX=24
POSTGRES_MEM_LIMIT=3g
POSTGRES_CPUS=2

# --- REDIS CACHE ---
REDIS_HOST=camara-redis
REDIS_PORT=6379
REDIS_PASSWORD=camara_redis_staging_secret
REDIS_MAXMEMORY=512mb
REDIS_MEM_LIMIT=640m

# --- INGESTION PRODUCER ---
RADIUS_SHARED_SECRET=camara-radius-staging-secret
RADIUS_UDP_RECEIVE_BUFFER_BYTES=33554432
RADIUS_UDP_QUEUE_MAX_RECORDS=100000
RADIUS_UDP_KAFKA_BATCH_RECORDS=250
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=5
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=32
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=64
RADIUS_UDP_PUBLISHER_WORKERS=4
RADIUS_ACK_CACHE_MAX_RECORDS=500000
RADIUS_ACK_CACHE_TTL_SECONDS=120
RADIUS_INGESTION_MEM_LIMIT=1g
RADIUS_INGESTION_CPUS=2

# --- PIPELINE CONSUMERS ---
CONSUMERS_PER_GROUP=4
PROCESSING_PARTITION_CONCURRENCY=3
BATCH_MAX_RECORDS=4000
BATCH_TIMEOUT_MS=20
THROUGHPUT_LOG_INTERVAL_SECONDS=10
PIPELINE_MEM_LIMIT=2g
PIPELINE_CPUS=2

# --- DISPATCHER & SECURITY ---
DISPATCHER_BATCH_SIZE=50
DISPATCHER_POLL_INTERVAL=2.0
DISPATCHER_MAX_ATTEMPTS=5
WEBHOOK_SIGNING_SECRET=camara_webhook_staging_secret
API_KEY=camara_api_key_staging_secret

# --- MONITORING ---
METRICS_PORT=9200
INGESTION_METRICS_PORT=9201
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=camara_grafana_staging_password
