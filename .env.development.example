# ==============================================================================
# CAMARA Data Pipeline — Development Environment Configuration (.env.development.example)
# Phù hợp cho môi trường Dev / Laptop (4 vCPU, 8GB RAM). Tải thử nghiệm < 5.000 pkt/s.
# ==============================================================================

ENVIRONMENT=development

# --- KAFKA & ZOOKEEPER ---
KAFKA_BOOTSTRAP_SERVERS=camara-kafka:9092,camara-kafka-2:9092,camara-kafka-3:9092
KAFKA_TOPIC_RAW=radius.accounting.raw
KAFKA_TOPIC_PARTITIONS=8
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
ZOOKEEPER_MEM_LIMIT=256m
KAFKA_MEM_LIMIT=1.5g
KAFKA_CPUS=1

# --- POSTGRESQL ENGINE ---
POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=camara_dev_password
POSTGRES_LOCAL_DB=camara_db
DATABASE_URL=postgresql://postgres:camara_dev_password@camara-postgres:5432/camara_db
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAX_WAL_SIZE=1GB
PIPELINE_DB_POOL_MIN=2
PIPELINE_DB_POOL_MAX=12
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1

# --- REDIS CACHE ---
REDIS_HOST=camara-redis
REDIS_PORT=6379
REDIS_PASSWORD=camara_redis_dev_secret
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m

# --- INGESTION PRODUCER ---
RADIUS_SHARED_SECRET=camara-radius-dev-secret
RADIUS_UDP_RECEIVE_BUFFER_BYTES=16777216
RADIUS_UDP_QUEUE_MAX_RECORDS=50000
RADIUS_UDP_KAFKA_BATCH_RECORDS=250
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=5
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=16
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=32
RADIUS_UDP_PUBLISHER_WORKERS=2
RADIUS_ACK_CACHE_MAX_RECORDS=100000
RADIUS_ACK_CACHE_TTL_SECONDS=120
RADIUS_INGESTION_MEM_LIMIT=512m
RADIUS_INGESTION_CPUS=1

# --- PIPELINE CONSUMERS ---
CONSUMERS_PER_GROUP=2
PROCESSING_PARTITION_CONCURRENCY=2
BATCH_MAX_RECORDS=2000
BATCH_TIMEOUT_MS=20
THROUGHPUT_LOG_INTERVAL_SECONDS=10
PIPELINE_MEM_LIMIT=1g
PIPELINE_CPUS=1

# --- DISPATCHER & SECURITY ---
DISPATCHER_BATCH_SIZE=20
DISPATCHER_POLL_INTERVAL=2.0
DISPATCHER_MAX_ATTEMPTS=5
WEBHOOK_SIGNING_SECRET=camara_webhook_dev_secret
API_KEY=camara_api_key_dev_secret

# --- MONITORING ---
METRICS_PORT=9200
INGESTION_METRICS_PORT=9201
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=camara_grafana_dev_password
