{
    "annotations": {
        "list": []
    },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "Pipeline System Throughput (rec/s)",
            "type": "timeseries",
            "id": 1,
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prom_ds"
                    },
                    "expr": "rate(fastapi_requests_total[1m]) or rate(spark_processed_rows_total[1m])",
                    "legendFormat": "{{job}} Throughput"
                }
            ],
            "options": {
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            }
        },
        {
            "title": "Kafka Consumer Lag per Topic/Partition",
            "type": "timeseries",
            "id": 2,
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prom_ds"
                    },
                    "expr": "kafka_consumergroup_lag{topic=~\"radius.*\"}",
                    "legendFormat": "{{topic}} - Partition {{partition}}"
                }
            ],
            "options": {
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            }
        },
        {
            "title": "API Latency Percentile 95 (p95) Response Time",
            "type": "timeseries",
            "id": 3,
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prom_ds"
                    },
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path, job))",
                    "legendFormat": "{{job}} [{{path}}] p95"
                }
            ],
            "options": {
                "tooltip": {
                    "mode": "single",
                    "sort": "none"
                }
            }
        }
    ],
    "refresh": "5s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [
        "camara",
        "pipeline"
    ],
