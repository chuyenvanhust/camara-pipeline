# ==============================================================================
# CAMARA Network API Data Pipeline — Full Environment Configuration (.env.example)
# Tất cả biến cấu hình của dự án được gom tại đây để khả chuyển khi thay đổi phần cứng.
# ==============================================================================

# ==============================================================================
# 1. HẠ TẦNG KAFKA CLUSTER & ZOOKEEPER
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=camara-kafka:9092,camara-kafka-2:9092,camara-kafka-3:9092
KAFKA_TOPIC_RAW=radius.accounting.raw
KAFKA_TOPIC_PARTITIONS=16
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_NUM_NETWORK_THREADS=8
KAFKA_NUM_IO_THREADS=16

# Giới hạn tài nguyên Container Kafka & ZooKeeper
ZOOKEEPER_MEM_LIMIT=256m
KAFKA_MEM_LIMIT=3g
KAFKA_CPUS=2

# ==============================================================================
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (STORAGE & SESSION STATE)
# ==============================================================================
POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=camara_dev_secure_password_change_me
POSTGRES_LOCAL_DB=camara_db
DATABASE_URL=postgresql://postgres:camara_dev_secure_password_change_me@camara-postgres:5432/camara_db

# Cấu hình Tuning PostgreSQL Engine (Tùy chỉnh theo RAM/CPU phần cứng)
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_WAL_SIZE=2GB

# Cấu hình Connection Pool asyncpg cho Pipeline
PIPELINE_DB_POOL_MIN=6
PIPELINE_DB_POOL_MAX=24

# Giới hạn tài nguyên Container PostgreSQL
POSTGRES_MEM_LIMIT=3g
POSTGRES_CPUS=2

# ==============================================================================
# 3. REDIS IN-MEMORY DATABASE & CACHE
# ==============================================================================
REDIS_HOST=camara-redis
REDIS_PORT=6379
REDIS_PASSWORD=camara_redis_dev_secret
REDIS_SENTINELS=
REDIS_MASTER_NAME=camara-master
REDIS_MAXMEMORY=512mb

# Giới hạn tài nguyên Container Redis
REDIS_MEM_LIMIT=640m

# ==============================================================================
# 4. TẦNG TIẾP NHẬN DỮ LIỆU RADIUS UDP INGESTION (PRODUCER)
# ==============================================================================
RADIUS_SHARED_SECRET=camara-radius-dev-secret
RADIUS_UDP_RECEIVE_BUFFER_BYTES=33554432
RADIUS_UDP_QUEUE_MAX_RECORDS=100000
RADIUS_UDP_KAFKA_BATCH_RECORDS=250
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=5
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=32
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=64
RADIUS_UDP_PUBLISHER_WORKERS=4
RADIUS_ACK_CACHE_MAX_RECORDS=500000
RADIUS_ACK_CACHE_TTL_SECONDS=120

# Giới hạn tài nguyên Container Ingestion
RADIUS_INGESTION_MEM_LIMIT=1g
RADIUS_INGESTION_CPUS=2

# ==============================================================================
# 5. TẦNG XỬ LÝ PIPELINE CONSUMERS (CONSUMER MODULES)
# ==============================================================================
CONSUMERS_PER_GROUP=4
PROCESSING_PARTITION_CONCURRENCY=3
BATCH_MAX_RECORDS=4000
BATCH_TIMEOUT_MS=20
THROUGHPUT_LOG_INTERVAL_SECONDS=10

# Giới hạn tài nguyên Container Pipeline
PIPELINE_MEM_LIMIT=2g
PIPELINE_CPUS=2

# ==============================================================================
# 6. TRANSACTIONAL OUTBOX DISPATCHER (WEBHOOK NOTIFICATIONS)
# ==============================================================================
DISPATCHER_BATCH_SIZE=50
DISPATCHER_POLL_INTERVAL=2.0
DISPATCHER_MAX_ATTEMPTS=5
WEBHOOK_SIGNING_SECRET=camara_webhook_hmac_secret_key

# Giới hạn tài nguyên Container Dispatcher
DISPATCHER_MEM_LIMIT=256m

# ==============================================================================
# 7. CAMARA FASTAPI GATEWAY & SECURITY
# ==============================================================================
ENVIRONMENT=development
API_KEY=camara_api_key_dev_secret_change_me
OAUTH_ISSUER_URL=https://auth.telecom.example.com/realms/camara
OAUTH_CLIENT_ID=camara-api-gateway
FORWARDED_ALLOW_IPS=127.0.0.1

# Giới hạn tài nguyên Container FastAPI
FASTAPI_MEM_LIMIT=512m

# ==============================================================================
# 8. TELEMETRY, METRICS EXPORTER & MONITORING
# ==============================================================================
METRICS_PORT=9200
INGESTION_METRICS_PORT=9201
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=camara_grafana_admin_password

# Giới hạn tài nguyên Container Prometheus & Grafana
PROMETHEUS_MEM_LIMIT=256m
GRAFANA_MEM_LIMIT=256m
