# CAMARA Pipeline - base profile 12 vCPU / 8 GiB RAM
# Sao chep thanh .env va thay tat ca secret truoc khi dung ngoai local/dev.
COMPOSE_PROJECT_NAME=camara-pipeline

KAFKA_BOOTSTRAP_SERVERS=camara-kafka:9092,camara-kafka-2:9092,camara-kafka-3:9092
KAFKA_TOPIC_RAW=radius.accounting.raw
KAFKA_TOPIC_PARTITIONS=9
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_CPUS=1
KAFKA_MEM_LIMIT=900m
KAFKA_HEAP_OPTS="-Xms448M -Xmx448M"
KAFKA_NUM_NETWORK_THREADS=3
KAFKA_NUM_IO_THREADS=8
ZOOKEEPER_MEM_LIMIT=192m

POSTGRES_LOCAL_USER=postgres
POSTGRES_LOCAL_PASSWORD=change-me
POSTGRES_LOCAL_DB=camara_db
DATABASE_URL=postgresql://postgres:change-me@camara-postgres:5432/camara_db
POSTGRES_MAX_CONNECTIONS=80
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_WORK_MEM=4MB
POSTGRES_MAX_WAL_SIZE=1GB
PIPELINE_DB_POOL_MIN=1
PIPELINE_DB_POOL_MAX=4
IP_MSISDN_DB_POOL_MIN=3
IP_MSISDN_DB_POOL_MAX=12
DEVICE_SWAP_DB_POOL_MIN=2
DEVICE_SWAP_DB_POOL_MAX=8
SIM_SWAP_DB_POOL_MIN=2
SIM_SWAP_DB_POOL_MAX=8
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.5

REDIS_HOST=camara-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_MAXMEMORY=256mb
REDIS_MEM_LIMIT=384m
FASTAPI_MEM_LIMIT=320m

RADIUS_SHARED_SECRET=change-me
RADIUS_UDP_RECEIVE_BUFFER_BYTES=16777216
RADIUS_UDP_QUEUE_MAX_RECORDS=20000
RADIUS_UDP_KAFKA_BATCH_RECORDS=64
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=1
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=4
RADIUS_UDP_KAFKA_PRESSURE_INFLIGHT_BATCHES_PER_WORKER=6
RADIUS_UDP_KAFKA_PRESSURE_QUEUE_RATIO=0.25
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=24
RADIUS_UDP_PUBLISHER_WORKERS=4
RADIUS_UDP_KAFKA_PRODUCERS=4
INGESTION_BATCH_SIZE_BYTES=262144
INGESTION_LINGER_MS=0
INGESTION_COMPRESSION_TYPE=lz4
INGESTION_KAFKA_ACKS=1
INGESTION_ENABLE_IDEMPOTENCE=false
INGESTION_RETRY_BACKOFF_MS=100
INGESTION_KAFKA_PERSIST_WARN_MS=18
INGESTION_QUEUE_WARN_MS=4
PIPELINE_SLA_E2E_P95_MS=100
PIPELINE_RECOMMENDED_SUSTAINED_PPS=2900
PIPELINE_RECOMMENDED_BURST_PPS=2900
RADIUS_INGESTION_MEM_LIMIT=1g
RADIUS_INGESTION_CPUS=1.5

PIPELINE_IP_REPLICAS=1
IP_MSISDN_CONSUMERS_PER_GROUP=3
IP_MSISDN_PARTITION_CONCURRENCY=3
IP_MSISDN_PARTITION_QUEUE_RECORDS=64
IP_MSISDN_BATCH_MAX_RECORDS=16
IP_MSISDN_BATCH_TIMEOUT_MS=1
PIPELINE_IP_MEM_LIMIT=512m
PIPELINE_IP_CPUS=2
PIPELINE_DEVICE_REPLICAS=1
DEVICE_SWAP_CONSUMERS_PER_GROUP=3
DEVICE_SWAP_PARTITION_CONCURRENCY=3
DEVICE_SWAP_PARTITION_QUEUE_RECORDS=96
DEVICE_SWAP_BATCH_MAX_RECORDS=24
DEVICE_SWAP_BATCH_TIMEOUT_MS=1
PIPELINE_DEVICE_MEM_LIMIT=512m
PIPELINE_DEVICE_CPUS=1
PIPELINE_SIM_REPLICAS=1
SIM_SWAP_CONSUMERS_PER_GROUP=3
SIM_SWAP_PARTITION_CONCURRENCY=3
SIM_SWAP_PARTITION_QUEUE_RECORDS=96
SIM_SWAP_BATCH_MAX_RECORDS=24
SIM_SWAP_BATCH_TIMEOUT_MS=1
PIPELINE_SIM_MEM_LIMIT=512m
PIPELINE_SIM_CPUS=1
THROUGHPUT_LOG_INTERVAL_SECONDS=10
PROCESSING_PARTITION_QUEUE_HIGH_RATIO=0.75
PROCESSING_PARTITION_QUEUE_LOW_RATIO=0.25
PROCESSING_PARTITION_QUEUE_MAX_AGE_MS=7
PROCESSING_PARTITION_QUEUE_RESUME_AGE_MS=3
PROCESSING_COMMIT_INTERVAL_MS=5
PROCESSING_COMMIT_MAX_RECORDS=256
PROCESSING_COMMIT_MAX_FAILURES=5
PROCESSING_COMMIT_RETRY_BACKOFF_MS=25

DISPATCHER_BATCH_SIZE=50
DISPATCHER_POLL_INTERVAL=2.0
DISPATCHER_MAX_ATTEMPTS=5
DISPATCHER_MEM_LIMIT=128m
WEBHOOK_SIGNING_SECRET=change-me
ENVIRONMENT=development
API_KEY=change-me
OAUTH_ISSUER_URL=https://auth.telecom.example.com/realms/camara
OAUTH_CLIENT_ID=camara-api-gateway
FORWARDED_ALLOW_IPS=127.0.0.1

METRICS_PORT=9200
INGESTION_METRICS_PORT=9201
PROMETHEUS_MEM_LIMIT=192m
GRAFANA_MEM_LIMIT=128m
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
