POSTGRES_SYNCHRONOUS_COMMIT=off
REDIS_CPUS=0.5
RADIUS_UDP_QUEUE_MAX_RECORDS=20000
RADIUS_UDP_KAFKA_BATCH_RECORDS=64
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=1
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=6
RADIUS_UDP_KAFKA_PRESSURE_INFLIGHT_BATCHES_PER_WORKER=6
RADIUS_UDP_KAFKA_PRESSURE_QUEUE_RATIO=0.25
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=24
RADIUS_UDP_PUBLISHER_WORKERS=4
RADIUS_UDP_KAFKA_PRODUCERS=1
INGESTION_LINGER_MS=0
INGESTION_KAFKA_ACKS=1
INGESTION_ENABLE_IDEMPOTENCE=false
INGESTION_RETRY_BACKOFF_MS=100
INGESTION_KAFKA_PERSIST_WARN_MS=18
INGESTION_QUEUE_WARN_MS=4

PIPELINE_IP_REPLICAS=3
IP_MSISDN_CONSUMERS_PER_GROUP=1
IP_MSISDN_DB_POOL_MIN=1
