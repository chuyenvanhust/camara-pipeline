# LATENCY-FIRST PROFILE: 8 GiB RAM / 12 vCPU
# Conservative pre-certification ceiling for E2E p95 < 100ms.
PIPELINE_SLA_E2E_P95_MS=100
PIPELINE_RECOMMENDED_SUSTAINED_PPS=800
PIPELINE_RECOMMENDED_BURST_PPS=900

KAFKA_TOPIC_PARTITIONS=9
KAFKA_CPUS=1.5
KAFKA_REPLICATION_FACTOR=1
