IP_MSISDN_PARTITION_QUEUE_RECORDS=64
IP_MSISDN_BATCH_MAX_RECORDS=16
IP_MSISDN_BATCH_TIMEOUT_MS=1
PIPELINE_IP_MEM_LIMIT=768m
PIPELINE_IP_CPUS=1.5
PIPELINE_DEVICE_REPLICAS=2
