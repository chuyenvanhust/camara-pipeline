DEVICE_SWAP_PARTITION_CONCURRENCY=3
DEVICE_SWAP_PARTITION_QUEUE_RECORDS=96
DEVICE_SWAP_BATCH_MAX_RECORDS=24
DEVICE_SWAP_BATCH_TIMEOUT_MS=1
PIPELINE_DEVICE_MEM_LIMIT=512m
PIPELINE_DEVICE_CPUS=1
PIPELINE_SIM_REPLICAS=2
SIM_SWAP_CONSUMERS_PER_GROUP=2
SIM_SWAP_PARTITION_CONCURRENCY=3
SIM_SWAP_PARTITION_QUEUE_RECORDS=96
SIM_SWAP_BATCH_MAX_RECORDS=24
SIM_SWAP_BATCH_TIMEOUT_MS=1
