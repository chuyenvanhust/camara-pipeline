# LATENCY-FIRST PROFILE: 16 GiB RAM / 16 vCPU (nap sau .env)
# Admission ceiling da tinh theo E2E p95 < 100ms: 3.9k/s.
PIPELINE_SLA_E2E_P95_MS=100
PIPELINE_RECOMMENDED_SUSTAINED_PPS=3900
PIPELINE_RECOMMENDED_BURST_PPS=3900
KAFKA_TOPIC_PARTITIONS=12
KAFKA_CPUS=1.2
KAFKA_MEM_LIMIT=1536m
KAFKA_HEAP_OPTS="-Xms768M -Xmx768M"
KAFKA_NUM_NETWORK_THREADS=4
KAFKA_NUM_IO_THREADS=12
ZOOKEEPER_MEM_LIMIT=384m

POSTGRES_MAX_CONNECTIONS=120
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_WAL_SIZE=2GB
PIPELINE_DB_POOL_MIN=1
PIPELINE_DB_POOL_MAX=6
IP_MSISDN_DB_POOL_MAX=16
DEVICE_SWAP_DB_POOL_MAX=10
SIM_SWAP_DB_POOL_MAX=10
POSTGRES_MEM_LIMIT=2560m
POSTGRES_CPUS=2.5

REDIS_MAXMEMORY=768mb
REDIS_MEM_LIMIT=1g
FASTAPI_MEM_LIMIT=512m

RADIUS_UDP_RECEIVE_BUFFER_BYTES=33554432
RADIUS_UDP_QUEUE_MAX_RECORDS=30000
RADIUS_UDP_KAFKA_BATCH_RECORDS=64
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=1
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=4
RADIUS_UDP_KAFKA_PRESSURE_INFLIGHT_BATCHES_PER_WORKER=6
RADIUS_UDP_KAFKA_PRESSURE_QUEUE_RATIO=0.25
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=24
RADIUS_UDP_PUBLISHER_WORKERS=4
RADIUS_UDP_KAFKA_PRODUCERS=4
INGESTION_BATCH_SIZE_BYTES=524288
INGESTION_LINGER_MS=0
INGESTION_KAFKA_ACKS=1
INGESTION_ENABLE_IDEMPOTENCE=false
INGESTION_RETRY_BACKOFF_MS=100
INGESTION_KAFKA_PERSIST_WARN_MS=18
INGESTION_QUEUE_WARN_MS=4
RADIUS_INGESTION_MEM_LIMIT=1g
RADIUS_INGESTION_CPUS=1.5

PIPELINE_IP_REPLICAS=2
IP_MSISDN_CONSUMERS_PER_GROUP=2
