# LATENCY-FIRST PROFILE: 32 GiB RAM / 24 vCPU (nap sau .env)
# Admission ceiling da tinh theo E2E p95 < 100ms: 7.8k/s.
PIPELINE_SLA_E2E_P95_MS=100
PIPELINE_RECOMMENDED_SUSTAINED_PPS=7800
PIPELINE_RECOMMENDED_BURST_PPS=7800
KAFKA_TOPIC_PARTITIONS=24
KAFKA_CPUS=2.5
KAFKA_MEM_LIMIT=3g
KAFKA_HEAP_OPTS="-Xms1536M -Xmx1536M"
KAFKA_NUM_NETWORK_THREADS=8
KAFKA_NUM_IO_THREADS=16
ZOOKEEPER_MEM_LIMIT=512m

POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_WAL_SIZE=4GB
PIPELINE_DB_POOL_MIN=2
PIPELINE_DB_POOL_MAX=8
IP_MSISDN_DB_POOL_MIN=1
IP_MSISDN_DB_POOL_MAX=12
DEVICE_SWAP_DB_POOL_MIN=1
DEVICE_SWAP_DB_POOL_MAX=5
SIM_SWAP_DB_POOL_MIN=1
SIM_SWAP_DB_POOL_MAX=5
POSTGRES_MEM_LIMIT=6g
POSTGRES_CPUS=4.5

REDIS_MAXMEMORY=1536mb
