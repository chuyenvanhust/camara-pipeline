# LATENCY-FIRST CANDIDATE: 64 GiB RAM / 32 vCPU (loaded after .env)
# 15.5k/s is an observe-only benchmark target, not a hard admission limit or SLO claim.
PIPELINE_SLA_E2E_P95_MS=100
PIPELINE_RECOMMENDED_SUSTAINED_PPS=15500
PIPELINE_RECOMMENDED_BURST_PPS=15500
KAFKA_TOPIC_PARTITIONS=48
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_CPUS=2.5
KAFKA_MEM_LIMIT=6g
KAFKA_HEAP_OPTS="-Xms3G -Xmx3G"
KAFKA_NUM_NETWORK_THREADS=12
KAFKA_NUM_IO_THREADS=24
ZOOKEEPER_MEM_LIMIT=1g

POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SYNCHRONOUS_COMMIT=on
POSTGRES_SHARED_BUFFERS=4GB
POSTGRES_EFFECTIVE_CACHE_SIZE=16GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAX_WAL_SIZE=8GB
PIPELINE_DB_POOL_MIN=2
PIPELINE_DB_POOL_MAX=12
IP_MSISDN_DB_POOL_MIN=1
IP_MSISDN_DB_POOL_MAX=16
DEVICE_SWAP_DB_POOL_MIN=1
DEVICE_SWAP_DB_POOL_MAX=7
SIM_SWAP_DB_POOL_MIN=1
SIM_SWAP_DB_POOL_MAX=7
POSTGRES_MEM_LIMIT=12g
POSTGRES_CPUS=6

REDIS_MAXMEMORY=3gb
REDIS_MEM_LIMIT=4g
REDIS_CPUS=2
FASTAPI_MEM_LIMIT=1g

RADIUS_UDP_RECEIVE_BUFFER_BYTES=134217728
RADIUS_UDP_QUEUE_MAX_RECORDS=120000
RADIUS_UDP_KAFKA_BATCH_RECORDS=64
RADIUS_UDP_KAFKA_BATCH_WAIT_MS=1
RADIUS_UDP_KAFKA_MAX_INFLIGHT_BATCHES_PER_WORKER=6
RADIUS_UDP_KAFKA_PRESSURE_INFLIGHT_BATCHES_PER_WORKER=8
RADIUS_UDP_KAFKA_PRESSURE_QUEUE_RATIO=0.25
RADIUS_UDP_KAFKA_TOTAL_MAX_INFLIGHT_BATCHES=64
RADIUS_UDP_PUBLISHER_WORKERS=8
RADIUS_UDP_KAFKA_PRODUCERS=4
INGESTION_BATCH_SIZE_BYTES=1048576
INGESTION_LINGER_MS=0
INGESTION_KAFKA_ACKS=1
INGESTION_ENABLE_IDEMPOTENCE=false
INGESTION_RETRY_BACKOFF_MS=100
INGESTION_KAFKA_PERSIST_WARN_MS=30
INGESTION_QUEUE_WARN_MS=12
RADIUS_INGESTION_MEM_LIMIT=3g
RADIUS_INGESTION_CPUS=3

PIPELINE_IP_REPLICAS=8
IP_MSISDN_CONSUMERS_PER_GROUP=1
IP_MSISDN_PARTITION_CONCURRENCY=6
IP_MSISDN_PARTITION_QUEUE_RECORDS=64
IP_MSISDN_BATCH_MAX_RECORDS=48
IP_MSISDN_BATCH_TIMEOUT_MS=5
PIPELINE_IP_MEM_LIMIT=768m
PIPELINE_IP_CPU_SHARES=1024
PIPELINE_DEVICE_REPLICAS=8
DEVICE_SWAP_CONSUMERS_PER_GROUP=1
DEVICE_SWAP_PARTITION_CONCURRENCY=6
DEVICE_SWAP_PARTITION_QUEUE_RECORDS=96
DEVICE_SWAP_BATCH_MAX_RECORDS=64
DEVICE_SWAP_BATCH_TIMEOUT_MS=5
PIPELINE_DEVICE_MEM_LIMIT=256m
PIPELINE_DEVICE_CPU_SHARES=768
PIPELINE_SIM_REPLICAS=8
SIM_SWAP_CONSUMERS_PER_GROUP=1
SIM_SWAP_PARTITION_CONCURRENCY=6
SIM_SWAP_PARTITION_QUEUE_RECORDS=96
SIM_SWAP_BATCH_MAX_RECORDS=64
SIM_SWAP_BATCH_TIMEOUT_MS=5
PIPELINE_SIM_MEM_LIMIT=256m
PIPELINE_SIM_CPU_SHARES=768
IP_MSISDN_REDIS_DB=0
DEVICE_SWAP_REDIS_DB=1
SIM_SWAP_REDIS_DB=2

PROCESSING_PARTITION_QUEUE_HIGH_RATIO=0.75
PROCESSING_PARTITION_QUEUE_LOW_RATIO=0.25
PROCESSING_PARTITION_QUEUE_MAX_AGE_MS=12
PROCESSING_PARTITION_QUEUE_RESUME_AGE_MS=4
PROCESSING_COMMIT_INTERVAL_MS=25
PROCESSING_COMMIT_MAX_RECORDS=512
PROCESSING_COMMIT_MAX_FAILURES=5
PROCESSING_COMMIT_RETRY_BACKOFF_MS=25
PROCESSING_COMBINE_WAIT_MS=2
PROCESSING_COMBINE_MAX_RECORDS=128
PROCESSING_COMBINE_QUEUE_BATCHES=128
SWAP_CHECKPOINT_INTERVAL_MS=150
SWAP_CHECKPOINT_MAX_RECORDS=1024
SWAP_CHECKPOINT_QUEUE_RECORDS=32768

DISPATCHER_MEM_LIMIT=512m
PROMETHEUS_MEM_LIMIT=1g
GRAFANA_MEM_LIMIT=512m
